import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.Objects;
import java.util.Random;
import java.util.concurrent.ThreadLocalRandom;
import javax.swing.*;
import java.awt.*;
import javax.swing.*;

public class Main {
    public static void main(String[] args) {
        JFrame frame = new JFrame("");
        JLabel label = new JLabel("Sapo Beudo!");
        JButton button = new JButton("TESTE");
        Random random = new Random();

        String[] desafio = {
                "Toda vez que você beber, terá que fazer uma flexão.",
                "O próximo a ir no banheiro dá 2 shots.",
                "Role um d3. O número que cair é a quantidade de shots que você irá tomar (em construcao)",
                "Mande uma foto fazendo uma careta para alguém que não está na roda agora."
                "Deixe o pessoal do roda escolherem a sua foto de perfil até o fim do jogo."
                "Mande uma mensagem fofa para alguém importante para você."
                "Imite alguém do roda. Se acertarem quem é, você bebe, se não, a pessoa imitada bebe."
                "Faça contato visual com a pessoa a sua esquerda por 30 segundos sem rir"
                "Faça contato visual com a pessoa a sua direita por 30 segundos sem rir"
                "Faça contato visual com a pessoa a sua frente por 30 segundos sem rir"
        };
        String[] pergunta = {

        };

        String[][] tudo = {desafio, pergunta};

        final String[] previousChoice = {""};
        button.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String currentChoice;
                String text;
                do {
                    int randomIndexList = random.nextInt(tudo.length);
                    int randomIndexChoice = random.nextInt(tudo[randomIndexList].length);
                    text = tudo[randomIndexList][randomIndexChoice];
                    currentChoice = text;
                    System.out.println(randomIndexChoice);
                } while (Objects.equals(currentChoice, previousChoice[0]));
                label.setText(text);
                previousChoice[0] = currentChoice;

            }
        });

        frame.setLayout(new GridBagLayout());

        frame.setSize(400, 300);
        frame.setLocationRelativeTo(null);
        frame.add(label);
        frame.add(button);
        frame.setVisible(true);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
    }}